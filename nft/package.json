{
  "name": "hairgames-nft",
  "version": "1.0.0",
  "private": true,
  "description": "HairGames NFT collections: contracts, deploy scripts and launch kits. Separate from the game contracts in ../contract.",
  "scripts": {
    "compile": "hardhat compile",
    "test": "hardhat test",
